<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hamburger menu: car avatar picker + nearest toilet -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hamburgerButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="☰"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Floats over the top of the map while a drive is active: shows the
             next up to 3 turns, refreshed automatically as you drive. -->
        <LinearLayout
            android:id="@+id/turnListPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:background="#DD1B1B1B"
            android:elevation="4dp"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/turn1Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="" />

            <TextView
                android:id="@+id/turn2Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/turn3Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="#99FFFFFF"
                android:visibility="gone"
                android:text="" />

        </LinearLayout>

        <!-- Recenter: appears once you've panned away from the follow camera -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/recenterButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="🎯"
            android:textSize="20sp"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toTopOf="@id/muteButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Mute: toggles spoken turn announcements -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/muteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="🔊"
            android:textSize="20sp"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:layout_constraintBottom_toTopOf="@id/stopDriveButton"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Full setup panel, shown before a drive starts; hidden during one
             so the map can take over the screen, nav-app style. -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="?attr/colorSurface"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/radiusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:text="Explore radius: 3 km" />

            <SeekBar
                android:id="@+id/radiusSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="14"
                android:progress="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🎲 Start Random Drive" />

        </LinearLayout>

        <!-- Small floating stop control, shown only while a drive is active
             (the full controls panel above is hidden then). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopDriveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            android:backgroundTint="#D32F2F"
            android:text="⏹ Stop Drive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Slide-out drawer: pick your car avatar, jump to the nearest toilet -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:paddingTop="32dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Random Drive"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Choose your car"
            android:textSize="14sp"
            android:alpha="0.6" />

        <LinearLayout
            android:id="@+id/carOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <TextView
            android:id="@+id/toiletMenuItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="🚻  Nearest Toilet"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
